{
  "schema": "harness/project/v1",
  "id": "conhecerse",
  "name": "conhecerse",
  "sourceRoot": "../workspace",
  "sourceVersion": "0.3.0",
  "kind": "java-next",
  "manager": "pnpm-maven",
  "runtime": "java-node",
  "worktreeOf": null,
  "commands": {
    "install": "pnpm install --frozen-lockfile",
    "lint": "pnpm typecheck",
    "test": "pnpm test",
    "build": "pnpm build",
    "dev": "pnpm dev",
    "compose": null,
    "composeUp": null,
    "composeDown": null,
    "testBackend": "mvn -B -Prelease-gates verify -f backend/pom.xml",
    "testE2e": "pnpm test:e2e"
  },
  "gitflow": {
    "strategy": "gitflow",
    "main": "main",
    "develop": "develop",
    "featurePrefix": "feature/",
    "featurePrefixes": [
      "feature/",
      "codex/"
    ],
    "releasePrefix": "release/",
    "hotfixPrefix": "hotfix/",
    "allowDirectPushToMain": false,
    "publishRemote": "origin",
    "protection": {
      "requirePullRequest": true,
      "allowForcePush": false,
      "allowDeletion": false,
      "enforceAdmins": false
    }
  },
  "memory": {
    "workspace": "homelab",
    "server": "https://memory.lab/mcp",
    "tokenEnv": "AI_MEMORY_TOKEN",
    "project": "conhecerse"
  },
  "designSystem": null,
  "guardrails": [],
  "pipelines": [
    {
      "platform": "jenkins",
      "job": "conhecerse-dev",
      "sourceProject": "jenkies",
      "file": "pipelines/deploy-conhecerse-dev.Jenkinsfile",
      "purpose": "lab-validation-deploy"
    }
  ],
  "memoryScopeVerified": false
}
